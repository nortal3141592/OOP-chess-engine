@startuml
abstract class Player {
  # color: Color
  + selectMove(board: Board): Move
}
class HumanPlayer
class AIPlayer
Player <|-- HumanPlayer
Player <|-- AIPlayer

class Account {
  - username: String
  - passwordHash: String
  + authenticate(password: String): boolean
}
HumanPlayer "0..*" -- "1" Account : authenticated as

class Game {
  - mode: GameMode
  - isRated: boolean
  - status: GameStatus
  - turn: Color
  + start(): void
  + applyMove(m: Move): void
  + undoLastMove(): void
  + redoMove(): void
  + offerDraw(): DrawOffer
  + requestUndo(): UndoRequest
  + end(reason: GameEndReason): void
}
Game "1" *-- "2" Player : participants

class Board {
  - squares: Piece[8][8]
  + reset(): void
  + applyMove(m: Move): void
  + undoMove(m: Move): void
  + isInCheck(c: Color): boolean
  + isCheckmate(): boolean
  + isStalemate(): boolean
}
Game "1" *-- "1" Board

class Piece {
  - color: Color
  - type: PieceType
  - position: Position
}
Board "1" *-- "0..32" Piece : places

class Move {
  - from: Position
  - to: Position
  - isCapture: boolean
  - isCastling: boolean
  - isPromotion: boolean
  - status: MoveStatus
}
Game "1" *-- "0..*" Move : records
Move "0..*" -- "1" Piece : moves
Move "0..1" -- "0..1" Piece : captures

class Annotation {
  - type: AnnotationType
  - location: Position
}
Game "1" *-- "0..*" Annotation : displays

class DrawOffer {
  - status: OfferStatus
  + accept(): void
  + decline(): void
  + withdraw(): void
}
Game "1" *-- "0..1" DrawOffer : has pending
DrawOffer "1" -- "1" Player : offered by

class UndoRequest {
  - status: RequestStatus
  - requiresConsent: boolean
  + accept(): void
  + decline(): void
}
Game "1" *-- "0..1" UndoRequest : has pending
UndoRequest "0..1" -- "1" Player : requested by
@enduml